# ==============================================================================
# Public Frontend Configuration (Safe for Vite Client Bundle)
# ==============================================================================
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000

# Optional serverless AI endpoint URL (Leave blank to use intelligent client synthesis)
VITE_AI_FUNCTIONS_URL=https://us-central1-your-firebase-project-id.cloudfunctions.net

# ==============================================================================
# Backend & Firebase Cloud Functions Configuration
# ==============================================================================
GCLOUD_PROJECT=your-firebase-project-id
GOOGLE_CLOUD_LOCATION=global
# Model name configured in Vertex AI (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
