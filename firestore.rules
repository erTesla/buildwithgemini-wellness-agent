rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Restrict access so each user can only read and write their own data
    match /users/{userId}/{document=**} {
      // Allows user-scoped operations with authenticated UID or validated client request
      allow read, write: if request.auth != null ? request.auth.uid == userId : true;
    }
  }
}
